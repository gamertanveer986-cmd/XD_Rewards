            "transaction_type": {
              "type": "string",
              "minLength": 1,
              "description": "Optional filter, e.g. 'ad_reward', 'daily_bonus', 'withdrawal'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_withdrawals",
        "title": "List withdrawal requests",

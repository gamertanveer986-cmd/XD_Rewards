          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "How many requests to return."
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Optional status filter, e.g. 'pending' or 'completed'."
